rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() { return request.auth != null; }
    
    // Fungsi untuk cek apakah user yang login memiliki role admin/owner
    // Menggunakan get untuk keamanan level enterprise (validasi server-side)
    function isAdmin() { 
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner', 'admin_owner', 'super_admin']; 
    }

    // --- PROTEKSI DATA USER ---
    match /users/{userId} {
      // Siapapun bisa baca profil (untuk identitas atau admin cek list user)
      allow read: if true;
      
      // User baru bisa buat dokumen saat pertama kali login/register
      allow create: if isAuthenticated();
      
      // User hanya bisa edit profilnya sendiri, 
      // TAPI dilarang keras mengubah field 'role' agar tidak membobol akses admin
      allow update: if (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
                    || isAdmin();
      
      // Hapus data hanya oleh Admin/Super Admin
      allow delete: if isAdmin();
    }

    // --- KOLEKSI PUBLIK (BACA PUBLIK, TULIS KHUSUS ADMIN) ---
    match /barbershops/{shopId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /barbermen/{barberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tenants/{tenantId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- ANTREAN / QUEUES (CUSTOMER HANYA BISA CREATE & AKSES TIKET SENDIRI) ---
    match /queues/{queueId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (isAuthenticated() && resource.data.customer_id == request.auth.uid);
      allow delete: if isAdmin();
    }

    // --- DEFAULT RULE RESTRICTION (ANTI-WILDCARD OVERWRITE) ---
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
